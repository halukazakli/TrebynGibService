# Copy to .env next to compose.yaml and fill in. .env is not committed.

HOST_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# GIB integrator connection
Gib__BaseUrl=https://ebeyanpreprodapi.gib.gov.tr
Gib__Token=
Gib__Integrator=8920229035-IFS KURUMSAL
# Taxpayer used by GET /health/gib when none is given
Gib__ProbeTaxpayerId=

# Refuse approval calls (use on test bridges only)
# Bridge__BlockedPathFragments__0=onayla

# One block per customer IFS installation (index 0, 1, 2, ...)
Bridge__Clients__0__Id=
Bridge__Clients__0__SecretSha256=
Bridge__Clients__0__TaxpayerIds__0=
